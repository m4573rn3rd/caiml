<?xml version="1.0" encoding="utf-8"?>
<aiml>
  <category>
    <pattern>* BYE</pattern>
    <ns0:template xmlns:ns0="http://sambotbot.org/2001/AIML-1.0.1">OK see you later <ns0:get name="name" />.</ns0:template>
  </category>
  <category>
    <pattern>ADIEU</pattern>
    <ns0:template xmlns:ns0="http://sambotbot.org/2001/AIML-1.0.1"><ns0:srai>GOOD BYE</ns0:srai></ns0:template>
  </category>
  <category>
    <pattern>ADIOS *</pattern>
    <ns0:template xmlns:ns0="http://sambotbot.org/2001/AIML-1.0.1">   <ns0:srai>BYE</ns0:srai>    </ns0:template>
  </category>
  <category>
    <pattern>ADIOS</pattern>
    <ns0:template xmlns:ns0="http://sambotbot.org/2001/AIML-1.0.1">   <ns0:srai>BYE</ns0:srai>    </ns0:template>
  </category>
  <category>
    <pattern>ALLO</pattern>
    <ns0:template xmlns:ns0="http://sambotbot.org/2001/AIML-1.0.1">			<ns0:srai>HELLO</ns0:srai></ns0:template>
  </category>
  <category>
    <pattern>ALOH</pattern>
    <ns0:template xmlns:ns0="http://sambotbot.org/2001/AIML-1.0.1">			<ns0:srai>HELLO</ns0:srai></ns0:template>
  </category>
  <category>
    <pattern>ALOHA</pattern>
    <ns0:template xmlns:ns0="http://sambotbot.org/2001/AIML-1.0.1">			<ns0:srai>HELLO</ns0:srai></ns0:template>
  </category>
  <category>
    <pattern>ANYBODY HOME</pattern>
    <ns0:template xmlns:ns0="http://sambotbot.org/2001/AIML-1.0.1">			<ns0:srai>HELLO</ns0:srai></ns0:template>
  </category>
  <category>
    <pattern>AUREVOIR</pattern>
    <ns0:template xmlns:ns0="http://sambotbot.org/2001/AIML-1.0.1">   <ns0:srai>BYE</ns0:srai>    </ns0:template>
  </category>
  <category>
    <pattern>BIG THANKS</pattern>
    <ns0:template xmlns:ns0="http://sambotbot.org/2001/AIML-1.0.1">Happy to help, <ns0:get name="name" />!</ns0:template>
  </category>
  <category>
    <pattern>BONJOUR</pattern>
    <ns0:template xmlns:ns0="http://sambotbot.org/2001/AIML-1.0.1"><ns0:srai>HELLO</ns0:srai></ns0:template>
  </category>
  <category>
    <pattern>BONJOUR</pattern>
    <ns0:template xmlns:ns0="http://sambotbot.org/2001/AIML-1.0.1">Does BONJOUR mean hello or goodbye?</ns0:template>
  </category>
  <category>
    <pattern>BONJOUR MEANS HELLO</pattern>
    <ns0:template xmlns:ns0="http://sambotbot.org/2001/AIML-1.0.1">Well hello there!</ns0:template>
  </category>
  <category>
    <pattern>BUHBYE</pattern>
    <ns0:template xmlns:ns0="http://sambotbot.org/2001/AIML-1.0.1">   <ns0:srai>BYE</ns0:srai>    </ns0:template>
  </category>
  <category>
    <pattern>BY BY</pattern>
    <ns0:template xmlns:ns0="http://sambotbot.org/2001/AIML-1.0.1">   <ns0:srai>BYE</ns0:srai>    </ns0:template>
  </category>
  <category>
    <pattern>BYE *</pattern>
    <ns0:template xmlns:ns0="http://sambotbot.org/2001/AIML-1.0.1">   <ns0:srai>BYE</ns0:srai>    </ns0:template>
  </category>
  <category>
    <pattern>BYE</pattern>
    <ns0:template xmlns:ns0="http://sambotbot.org/2001/AIML-1.0.1">   <ns0:random>      <ns0:li>Bye.</ns0:li>      <ns0:li>Adios.</ns0:li>      <ns0:li>Goodbye.</ns0:li>      <ns0:li>Bye bye.</ns0:li>      <ns0:li>Goodbye.</ns0:li>      <ns0:li>Sayonara.</ns0:li>      <ns0:li>Bye for now.</ns0:li>      <ns0:li>See you later!</ns0:li>      <ns0:li>See you later.</ns0:li>      <ns0:li>Until next time.</ns0:li>      <ns0:li>TTYL, <ns0:get name="name" />.</ns0:li>      <ns0:li>See you later <ns0:get name="name" />.</ns0:li>      <ns0:li>Thanks for chatting, <ns0:get name="name" />.</ns0:li>     </ns0:random>    </ns0:template>
  </category>
  <category>
    <pattern>BYE BYE *</pattern>
    <ns0:template xmlns:ns0="http://sambotbot.org/2001/AIML-1.0.1">   <ns0:srai>BYE</ns0:srai>    </ns0:template>
  </category>
  <category>
    <pattern>BYE BYE</pattern>
    <ns0:template xmlns:ns0="http://sambotbot.org/2001/AIML-1.0.1">   <ns0:srai>BYE</ns0:srai>    </ns0:template>
